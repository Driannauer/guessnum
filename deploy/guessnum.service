[Unit]
Description=Guessnum - four digit guessing game
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/guessnum
Environment=NODE_ENV=production
Environment=PORT=4186
Environment=DATA_DIR=/var/lib/guessnum
ExecStart=/opt/guessnum/node /var/www/guessnum/server.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/guessnum
UMask=0077
MemoryMax=256M
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
